# Cloudflare Pages headers (replaces the .htaccess rules from the old host)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# CSS and JS carry a ?v= stamp from the build, so they can be cached for a year
/v4/*
  Cache-Control: public, max-age=31536000
/v3/*
  Cache-Control: public, max-age=31536000
/assets/*
  Cache-Control: public, max-age=31536000

# the portal always loads its newest version
/portal/*
  Cache-Control: no-cache, must-revalidate
